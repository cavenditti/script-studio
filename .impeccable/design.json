stroke-width=\"4.2\" stroke-linecap=\"butt\" stroke-linejoin=\"miter\"/></g></svg></span><span title=\"Word-initial form\"><svg viewBox=\"-8 -8 124 60\" aria-hidden=\"true\"><g transform=\"translate(28 0)\"><path d=\"M8 16V8H24Q40 8 40 16Q40 24 24 24H8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"8\" stroke-linecap=\"butt\" stroke-linejoin=\"miter\"/></g></svg></span></span><span class=\"ds-vowel-label\">ɔ</span><span class=\"ds-vowel-key\">ò</span></button></div></section><section class=\"ds-vowel-group\"><h3>Low</h3><div class=\"ds-vowel-grid\"><button class=\"ds-vowel\" aria-label=\"Insert a /a/\"><span class=\"ds-vowel-forms\"><span title=\"Diacritic\"><svg viewBox=\"-12 -15 125 60\" aria-hidden=\"true\"><g transform=\"translate(45 8)\"><path d=\"M-10 2Q-10-4-4-4H10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4.2\" stroke-linecap=\"butt\" stroke-linejoin=\"miter\"/></g></svg></span><span title=\"Word-initial form\"><svg viewBox=\"-8 -8 124 60\" aria-hidden=\"true\"><g transform=\"translate(28 0)\"><path d=\"M8 24V8H24Q40 8 40 16Q40 24 24 24Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"8\" stroke-linecap=\"butt\" stroke-linejoin=\"round\"/></g></svg></span></span><span class=\"ds-vowel-label\">a</span></button><button class=\"ds-vowel\" aria-label=\"Insert æ /æ/\"><span class=\"ds-vowel-forms\"><span title=\"Diacritic\"><svg viewBox=\"-12 -15 125 60\" aria-hidden=\"true\"><g transform=\"translate(45 8)\"><path d=\"M-12 4Q-10-2-3-2H7L11-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4.2\" stroke-linecap=\"butt\" stroke-linejoin=\"miter\"/></g></svg></span><span title=\"Word-initial form\"><svg viewBox=\"-8 -8 124 60\" aria-hidden=\"true\"><g transform=\"translate(45 16)\"><path d=\"M-12 4Q-10-2-3-2H7L11-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4.2\" stroke-linecap=\"butt\" stroke-linejoin=\"miter\"/></g></svg></span></span><span class=\"ds-vowel-label\">æ</span></button></div></section>",
      "css": ".ds-form-legend{font:.8125rem/1.5 \"Avenir Next\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--muted,#566569);margin:0 0 13px}.ds-vowel-group{margin-top:13px}.ds-vowel-group h3{font:550 .875rem \"Avenir Next\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--muted,#566569);margin:0 0 7px}.ds-vowel-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.ds-vowel{padding:6px 3px;border:1px solid transparent;background:#f5f7f7;border-radius:5px;color:var(--ink,#1b292c);min-height:76px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;transition:background .15s,color .15s}.ds-vowel-forms{display:grid;grid-template-columns:1fr 1fr;width:100%;align-items:center;gap:3px}.ds-vowel-forms>span{min-width:0}.ds-vowel-forms svg{width:100%;height:32px;overflow:visible}.ds-vowel-label{font:1rem/1.1 \"Charis SIL\",\"Doulos SIL\",Georgia,serif}.ds-vowel-key{font:.75rem/1 \"Avenir Next\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--muted,#566569)}.ds-vowel:hover{background:#e4eeee;border-color:#b7cdcf;color:#174b54}.ds-vowel:focus-visible{outline:2px solid var(--accent,#295c65);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-vowel{transition:none}}"
    }
  ],
  "narrative": {
    "overview": "The compact shell puts writing and preview directly below the header. There is no hero, repeated footer, output count, or specimen note. Short Save/Open and SVG/PNG actions keep the workspace concise. Grouped alphabet tabs and two collapsed disclosures provide explanation and appearance controls when needed.\n\nThe implementation in `src/style.css`, `src/index.html`, `src/app.js`, and `src/phonetics.js` is the authority. Current desktop and 375px screenshots in `.impeccable/review/` show the paired Vowels palette and repaired initial outlines; `marks.jpg` records the approved prosody palette. Browser checks exercised keyboard tab selection, IPA and mark insertion, Appearance controls, and transparent PNG export; mobile client and scroll widths were both 375px. Source tests cover the shared preview/export outlines, 11 paired buttons with 22 SVGs, approved prosody, and the schwa alias. Technical checks remain separate from creator acceptance of precise reconstructed curves.",
    "dos": [
      "Do keep the main writing flow compact and place extended explanations in the existing disclosures.",
      "Do retain typing keys when displayed IPA differs, and keep candidate additions distinct from implemented mappings.",
      "Do reuse local font stacks, selected-tab states, focus outlines, and reduced-motion behavior.",
      "Do keep original photographs at their aspect ratios and preserve the existing glyph geometry."
    ],
    "donts": [
      "Don't treat phonetic presentation groups as changes to transliteration keys or pronunciation rules.",
      "Don't describe browser checks as creator acceptance of every reconstructed curve.",
      "Don't require external fonts or icon packages for the standalone editor."
    ]
  }
}
